{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/fundraiser", "destination": "/fundraiser/index.html" },
    { "source": "/cantmakeit", "destination": "/fundraiser" },
    { "source": "/first", "destination": "/first/index.html" },
    { "source": "/funshare", "destination": "/funshare/index.html" },
    { "source": "/funraiser", "destination": "/funraiser/index.html" },
    { "source": "/s/:slug", "destination": "/survey" },
    { "source": "/fund",  "destination": "/api/track-redirect?l=fund" },
    { "source": "/fight", "destination": "/api/track-redirect?l=fight" },
    { "source": "/leaderboard", "destination": "/api/leaderboard" },
    { "source": "/supporters:date", "destination": "/webinar" }
  ],
  "crons": [
    { "path": "/api/cron/sms-inbound-poll", "schedule": "10 * * * *" },
    { "path": "/api/cron/lapse-sweep", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/nightly-rollup", "schedule": "15 18 * * *" },
    { "path": "/api/cron/identity-resolver", "schedule": "20 16 * * *" },
    { "path": "/api/cron/social-analyse", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/social-rollup", "schedule": "40 16 * * *" },
    { "path": "/api/cron/ad-insights", "schedule": "*/30 * * * *" },
    { "path": "/api/cron/unit-economics", "schedule": "50 16 * * *" },
    { "path": "/api/cron/survey-uid-push", "schedule": "20 17 * * *" },
    { "path": "/api/admin/survey-uids?mode=bulk&state=1&chunk=35", "schedule": "*/5 * * * *" }
  ],
  "functions": {
    "api/cron/sms-queue.js": { "maxDuration": 120 },
    "api/cron/sms-inbound-poll.js": { "maxDuration": 120 },
    "api/cron/lapse-sweep.js": { "maxDuration": 120 },
    "api/cron/refresh-signature-count.js": { "maxDuration": 120 },
    "api/cron/nightly-rollup.js": { "maxDuration": 300 },
    "api/admin/stripe-backfill.js": { "maxDuration": 300 },
    "api/zernio-webhook.js": { "maxDuration": 30 },
    "api/admin/seed-identities.js": { "maxDuration": 60 },
    "api/admin/backfill-conversations.js": { "maxDuration": 60 },
    "api/cron/identity-resolver.js": { "maxDuration": 60 },
    "api/cron/social-analyse.js": { "maxDuration": 60 },
    "api/cron/social-rollup.js": { "maxDuration": 60 },
    "api/admin/social-dashboard.js": { "maxDuration": 30 },
    "api/cron/ad-insights.js": { "maxDuration": 60 },
    "api/cron/unit-economics.js": { "maxDuration": 300 },
    "api/admin/econ-dashboard.js": { "maxDuration": 30 },
    "api/admin/stripe-import-donations.js": { "maxDuration": 300 },
    "api/admin/survey-uids.js": { "maxDuration": 300 },
    "api/cron/survey-uid-push.js": { "maxDuration": 120 }
  },
  "redirects": [
    { "source": "/rally",       "destination": "/fundraiser",           "permanent": false },
    { "source": "/demand",      "destination": "/demandcarroll#ff-email-form", "permanent": false },
    { "source": "/demanddambrosio", "destination": "/demandcarroll",    "permanent": false },
    { "source": "/demandvid",   "destination": "/demandcarroll#video",  "permanent": false },
    { "source": "/finish",      "destination": "/won",                  "permanent": false },
    { "source": "/fun",         "destination": "/fundraiser",           "permanent": false },
    { "source": "/baldwin",     "destination": "/take-action/baldwins", "permanent": false },
    { "source": "/baldwins",    "destination": "/take-action/baldwins", "permanent": false },
    { "source": "/defend",      "destination": "/take-action/baldwins#donate", "permanent": false },
    { "source": "/about-us",    "destination": "/the-fight",            "permanent": false },
    { "source": "/about-us.html","destination": "/the-fight",           "permanent": false },
    { "source": "/volunteer",   "destination": "/take-action/volunteer#signup",   "permanent": false },
    { "source": "/petition",    "destination": "/take-action/hold-the-gate#sign", "permanent": false },
    { "source": "/holdthegate", "destination": "/petition",                       "permanent": false },
    { "source": "/helpholdthegate", "destination": "/take-action/hold-the-gate#sign", "permanent": true },
    { "source": "/send-your-email", "destination": "/askjess", "permanent": false }
  ],
  "headers": [
    {
      "source": "/content/site.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/api/youtube",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=600, stale-while-revalidate=3600" }
      ]
    }
  ]
}
